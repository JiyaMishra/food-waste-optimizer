# No secrets are required for Person A's local synthetic-data pipeline.

# Person B backend configuration (copy to .env and adjust)
# PostgreSQL is the intended deployment database; local development may omit
# DATABASE_URL and use the SQLite fallback under backend/data/.
DATABASE_URL=postgresql+psycopg://food_optimizer:change-me@localhost:5432/food_optimizer
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
